    "@azure/identity": "^4.5.0",
    "@azure/storage-queue": "^12.25.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
