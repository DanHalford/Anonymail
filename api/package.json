{
  "name": "anonymail-api",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymail API and scheduler (Azure Functions, Flex Consumption).",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
